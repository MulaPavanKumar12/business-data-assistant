# ---------------------------------------------------------------
# Business Data Assistant - environment configuration
# Copy this file to .env and fill in ONE LLM option below:
#   cp .env.example .env          (Windows PowerShell: Copy-Item .env.example .env)
# ---------------------------------------------------------------

# --- LLM (required for answering questions) -------------------
# Option A: Claude (default)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5      # default; e.g. claude-sonnet-5-5 or claude-haiku-5-5 for lower cost/latency
LLM_EFFORT=low                   # Claude thinking effort: low | medium | high
LLM_ENABLE_FALLBACKS=true        # retry on a fallback model if a request is declined by a safety classifier

# Option B: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Option C: free local model with Ollama (https://ollama.com), e.g. `ollama pull llama3.1`
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# --- PostgreSQL (owner account: schema, seeding, audit and business API only) ---
POSTGRES_DB=business_db
POSTGRES_USER=bda_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_PORT=5432

# --- Read-only role used to run LLM-generated SQL ---
READONLY_DB_USER=bda_readonly
READONLY_DB_PASSWORD=change_me_readonly

# --- Security ---
JWT_SECRET=dev-only-change-me-to-a-long-random-string
DEMO_USER_PASSWORD=demo123      # password for the demo users vera/alex/omar/fiona/ada
INTERNAL_API_KEY=dev-internal-key
MAX_RESULT_ROWS=200

# --- Schema RAG: hybrid (ChromaDB embeddings + keyword) or keyword ---
RAG_BACKEND=hybrid

# --- Seed volumes (deterministic: same SEED -> same data) ---
SEED_RANDOM_SEED=42
SEED_NUM_CUSTOMERS=500
SEED_NUM_EMPLOYEES=60
SEED_NUM_PRODUCTS=120
SEED_NUM_ORDERS=5000

# --- Ports / logging ---
API_PORT=8000
UI_PORT=8501
LOG_LEVEL=INFO
